{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 - x64 (64-bit games)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64",
      "installDir": "${sourceDir}/dist/x64"
    },
    {
      "name": "vs2022-x86",
      "displayName": "Visual Studio 2022 - x86 (32-bit games)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/x86",
      "installDir": "${sourceDir}/dist/x86"
    }
  ],
  "buildPresets": [
    { "name": "x64-release", "configurePreset": "vs2022-x64", "configuration": "Release" },
    { "name": "x64-debug",   "configurePreset": "vs2022-x64", "configuration": "Debug" },
    { "name": "x86-release", "configurePreset": "vs2022-x86", "configuration": "Release" },
    { "name": "x86-debug",   "configurePreset": "vs2022-x86", "configuration": "Debug" }
  ]
}
